diff --git a/src/hyperresearch/web/hb_provider.py b/src/hyperresearch/web/hb_provider.py
new file mode 100644
index 0000000..ab36adf
--- /dev/null
+++ b/src/hyperresearch/web/hb_provider.py
@@ -0,0 +1,47 @@
+"""Study gateway web provider (added by the harness-bench adapter; not part of upstream).
+
+Routes every web search and page read through the study's local gateway, so this harness uses the
+same search backend, page reader, content limit, block list and budget as the other research arms.
+
+Configuration:
+    [web]
+    provider = "hb"
+Environment: HB_GATEWAY_URL and HB_RUN_TOKEN (set by the adapter for the run).
+"""
+
+from __future__ import annotations
+
+import os
+
+import httpx
+
+from hyperresearch.web.base import WebResult
+
+
+class HBGatewayProvider:
+    name = "hb"
+
+    def __init__(self) -> None:
+        self._url = os.environ.get("HB_GATEWAY_URL", "").rstrip("/")
+        self._token = os.environ.get("HB_RUN_TOKEN", "")
+        if not self._url or not self._token:
+            raise RuntimeError("HB_GATEWAY_URL and HB_RUN_TOKEN must be set for the hb web provider")
+
+    def _post(self, path: str, payload: dict) -> dict:
+        r = httpx.post(self._url + path, json=payload, headers={"x-api-key": self._token}, timeout=180)
+        r.raise_for_status()
+        data = r.json()
+        if "error" in data:
+            raise RuntimeError(data["error"])
+        return data
+
+    def fetch(self, url: str) -> WebResult:
+        data = self._post("/tools/fetch", {"url": url})
+        text = data.get("content") or ""
+        title = next((ln.strip("# ").strip() for ln in text.splitlines() if ln.strip()), url)[:200]
+        return WebResult(url=data.get("url") or url, title=title, content=text, metadata={"notice": data.get("notice", "")})
+
+    def search(self, query: str, max_results: int = 5) -> list[WebResult]:
+        data = self._post("/tools/search", {"query": query, "max_results": max_results})
+        return [WebResult(url=r.get("url") or "", title=r.get("title") or "", content=r.get("snippet") or "",
+                          metadata={"published": r.get("published")}) for r in data.get("results", [])]
