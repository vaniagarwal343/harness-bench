@@ -0,0 +1,36 @@
+"""`hyperresearch websearch` — web search through the configured provider (added by the harness-bench adapter).
+
+Upstream relies on the host agent's built-in web search tool. In the study that tool is unavailable,
+so the pipeline's planned searches run through this command instead. It lists results only; pages are
+read with `hyperresearch fetch` as usual.
+"""
+
+from __future__ import annotations
+
+import json
+
+import typer
+
+
+def websearch(
+    query: str = typer.Argument(..., help="Search query"),
+    max_results: int = typer.Option(5, "--max", "-m", help="Max results"),
+    json_output: bool = typer.Option(False, "--json", "-j", help="JSON output"),
+) -> None:
+    """Search the web and list results (title, url, snippet)."""
+    from hyperresearch.core.vault import Vault
+    from hyperresearch.web.base import get_provider
+
+    vault = Vault.discover()
+    prov = get_provider(vault.config.web_provider, settings=vault.config.fetch, gates=vault.config.junk)
+    try:
+        results = prov.search(query, max_results=max_results)
+    except Exception as e:  # shown to the agent as-is, e.g. when the research budget is used up
+        typer.echo(json.dumps({"ok": False, "error": str(e)}) if json_output else f"Search failed: {e}")
+        raise typer.Exit(1)
+    rows = [{"title": r.title, "url": r.url, "snippet": r.content[:600]} for r in results]
+    if json_output:
+        typer.echo(json.dumps({"ok": True, "query": query, "results": rows}, ensure_ascii=False))
+    else:
+        for i, r in enumerate(rows, 1):
+            typer.echo(f"{i}. {r['title']}\n   {r['url']}\n   {r['snippet'][:200]}")
