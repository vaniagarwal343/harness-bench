# Copy to .env (git-ignored). No contestant process reads this file or receives these values:
# the gateway holds the first two, and harness child processes get a scrubbed environment.

# contestant side (held by the gateway only)
ANTHROPIC_API_KEY=        # Claude Fable 5.2 for every configuration
EXA_API_KEY=              # shared search and page reading for B, C and D

# evaluator side (grading process only)
TYPESAFE_API_KEY=         # Jev judge

# The GPT-6 Astra judge runs through the Codex CLI's own signed-in session. There is no key for it here,
# and OPENAI_API_KEY is removed from the judge's environment so a paid API route cannot be used by accident.
